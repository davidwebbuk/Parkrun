# Optional: National Rail Enquiries OJP Real Time Journey Planner (RTJP).
# When all three are set, /api/reachable refines its top candidates with a
# real multi-leg journey lookup instead of the straight-line-distance
# heuristic. Unset (or partially set) -> the app runs on the heuristic only,
# same as before. See README.md "Adding real timetables".
#
# OJP_ENDPOINT_URL is the SOAP endpoint (the <soap:address location> from
# the WSDL at http://ojp.nationalrail.co.uk/webservices/jpdlr.wsdl, or from
# your raildata.org.uk product/subscription page) - NOT verified against a
# live account in this codebase; confirm it yourself.
OJP_ENDPOINT_URL=

# HTTP Basic Auth credentials for the OJP live environment (the guide also
# allows IP allow-listing instead of username/password, but that only
# suits a server with a fixed, known outbound IP).
OJP_USERNAME=
OJP_PASSWORD=

PORT=3000
