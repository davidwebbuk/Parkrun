# Optional: live transit directions via Google's Directions API. When set,
# /api/reachable refines its top candidates with a real Google Maps transit
# lookup instead of the straight-line-distance heuristic, and can tell you
# when a route needs a bus rather than being pure train. Unset -> the app
# runs on the heuristic only, same as before. See README.md "Adding real
# timetables".
#
# Set up: create/select a project in Google Cloud Console, enable the
# "Directions API", enable billing on the project (required even for
# free-tier usage), then create an API key.
GOOGLE_MAPS_API_KEY=

PORT=3000

# Optional: how many live Google Directions calls run in parallel per search
# (default 3). Raise this on a VPS/PaaS with no strict per-account CPU or
# connection limits for faster responses; leave it low (or unset) on
# constrained shared hosting (e.g. a CloudLinux LVE-limited cPanel account),
# where a higher value can get the whole Node process killed mid-request -
# showing up to visitors as a bare 503 with nothing in the app's own logs.
# LIVE_REFINE_CONCURRENCY=3

# --- Alternative path, not currently used by the app (see README) ---
# National Rail's OJP Real Time Journey Planner turned out to require a
# formal paid contract with RDG rather than a self-serve API key, so the
# app doesn't use it by default. The client code (server/lib/ojpClient.js)
# is still there and works if you go through that licensing process later.
# OJP_ENDPOINT_URL=
# OJP_USERNAME=
# OJP_PASSWORD=
